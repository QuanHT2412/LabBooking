<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_50"
    tools:context=".activities.CartConfirm.CartConfirmActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            app:title="Additional Information"
            android:background="@color/main_900"
            app:titleTextColor="@color/main_50"
            app:navigationIconTint="@color/main_50"
            app:titleTextAppearance="@style/OrderConfirmationToolbarTitle"
            app:navigationIcon="@drawable/ic_chevron_left" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Note: A RecyclerView can also be used -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- SELECT DATE -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/et_date_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Date"
                android:layout_marginTop="20dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="@color/main_800"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_date"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SELECT START TIME -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/et_starttime_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Start Time"
                android:layout_marginTop="12dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:startIconDrawable="@drawable/ic_clock"
                app:startIconTint="@color/main_800"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintTop_toBottomOf="@id/et_date_wrapper"
                app:layout_constraintStart_toStartOf="parent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_starttime"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SELECT END TIME -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/et_endtime_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="End Time"
                android:layout_marginTop="12dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:startIconDrawable="@drawable/ic_clock"
                app:startIconTint="@color/main_800"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintTop_toBottomOf="@id/et_starttime_wrapper"
                app:layout_constraintStart_toStartOf="parent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_endtime"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.textfield.TextInputLayout>



            <LinearLayout
                android:id="@+id/ll_facility_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/et_endtime_wrapper"
                app:layout_constraintStart_toStartOf="parent">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_tools"
                    app:tint="@color/main_800"
                    android:contentDescription="Tools Icon"/>

                <TextView
                    android:text="Select additional facilities"
                    android:textSize="16sp"
                    android:textColor="@color/main_800"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/facilityRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/ll_facility_header"
                app:layout_constraintStart_toStartOf="parent"/>

            <Button
                android:id="@+id/btn_add"
                android:text="Add to cart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/main_900"
                android:layout_marginHorizontal="16dp"
                app:cornerRadius="10dp"
                android:paddingVertical="12dp"
                style="@style/Widget.MaterialComponents.Button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/facilityRecyclerView"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>