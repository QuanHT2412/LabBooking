<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginHorizontal="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_product"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@drawable/image_not_found"
            card_view:shapeAppearanceOverlay="@style/RoundedCorners"
            tools:ignore="ContentDescription"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:id="@+id/tv_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sample Product Name"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/stone_950"
            android:maxLines="1"
            android:ellipsize="end"
            card_view:layout_constraintTop_toBottomOf="@+id/image_product"
            card_view:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:paddingStart="16dp"
            android:id="@+id/tv_product_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is a sample product description for preview purposes."
            android:textSize="14sp"
            android:textColor="@color/slate_500"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            card_view:layout_constraintTop_toBottomOf="@+id/tv_product_name"
            card_view:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            card_view:layout_constraintBottom_toBottomOf="parent"
            card_view:layout_constraintStart_toStartOf="parent"
            android:id="@+id/tv_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingStart="16dp"
            android:text="$99.99"
            android:textColor="@color/main_400"
            android:textSize="16sp"
            android:textStyle="bold" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
